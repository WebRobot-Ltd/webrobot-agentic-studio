{
  "name": "webrobot-agentic-studio",
  "version": "0.1.0",
  "description": "WebRobot Agent Studio — host-agnostic React visual DAG editor for authoring the agent/crew graph that executes on Ray.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "@xyflow/react": ">=12",
    "lucide-react": ">=0.400"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18",
    "@xyflow/react": "^12",
    "lucide-react": "^0.400"
  },
  "keywords": ["webrobot", "agentic", "agents", "crewai", "ray", "dag", "orchestration", "react", "reactflow"],
  "repository": { "type": "git", "url": "git+https://github.com/WebRobot-Ltd/webrobot-agentic-studio.git" },
  "sideEffects": ["*.css"]
}
